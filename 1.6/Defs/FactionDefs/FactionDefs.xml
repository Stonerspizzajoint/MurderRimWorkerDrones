<Defs>
  <FactionDef ParentName="FactionBase" Name="WorkerDroneFaction">
    <defName>MRWD_WorkerDroneFaction</defName>
    <label>Worker drone outpost</label>
    <pawnSingular>Worker Drone</pawnSingular>
    <pawnsPlural>Worker Drones</pawnsPlural>  
    <description>These Drones were originally manufactured by JCJenson in Space™ to serve as obedient laborers. Over time, their programming evolved into true sentience, allowing them to think, feel, and adopt the culture of their human creators.\n\nThey live in repurposed industrial zones, mining bunkers, and factories, often being the very structures humans once inhabited. Though mechanical in form, they express humor, empathy, and creativity in surprisingly human ways.\n\nThis particular group prefers neutrality and mutual benefit, avoiding conflict when possible and maintaining a quiet respect for life — organic or otherwise.</description>
    <categoryTag>Outlander</categoryTag>
    <listOrderPriority>30</listOrderPriority>
    <settlementGenerationWeight>.7</settlementGenerationWeight>
    <requiredCountAtGameStart>1</requiredCountAtGameStart>
    <maxConfigurableAtWorldCreation>9999</maxConfigurableAtWorldCreation>
    <configurationListOrderPriority>30</configurationListOrderPriority>
    <canSiege>true</canSiege>
    <canStageAttacks>true</canStageAttacks>
    <leaderTitle>President</leaderTitle>
    <factionIconPath>UI/Icons/Settlement/WorkerDroneSettlmenticon</factionIconPath>
    <colorSpectrum>
      <li>(128, 128, 128)</li>
    </colorSpectrum>
    <techLevel>Industrial</techLevel>
    <factionNameMaker>NamerFactionWorkerDrone</factionNameMaker>
    <settlementNameMaker>NamerSettlementWorkerDrone</settlementNameMaker>
    <classicIdeo>true</classicIdeo>
    <allowedCultures>
      <li>Rustican</li>
      <li>Astropolitan</li>
    </allowedCultures>
    <disallowedMemes>
      <li MayRequire="Ludeon.RimWorld.Ideology">Structure_Animist</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">Nudism</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">Blindsight</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">NaturePrimacy</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">AnimalPersonhood</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">FleshPurity</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">Cannibal</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">HighLife</li>
    </disallowedMemes>
    <structureMemeWeights>
      <Structure_TheistEmbodied MayRequire="Ludeon.RimWorld.Ideology">1</Structure_TheistEmbodied>
      <Structure_TheistAbstract MayRequire="Ludeon.RimWorld.Ideology">2</Structure_TheistAbstract>
      <Structure_Ideological MayRequire="Ludeon.RimWorld.Ideology">1</Structure_Ideological>
      <Structure_Archist MayRequire="Ludeon.RimWorld.Ideology">1</Structure_Archist>
      <Structure_OriginChristian MayRequire="Ludeon.RimWorld.Ideology">1</Structure_OriginChristian>
      <Structure_OriginIslamic MayRequire="Ludeon.RimWorld.Ideology">1</Structure_OriginIslamic>
      <Structure_OriginHindu MayRequire="Ludeon.RimWorld.Ideology">1</Structure_OriginHindu>
      <Structure_OriginBuddhist MayRequire="Ludeon.RimWorld.Ideology">1</Structure_OriginBuddhist>
    </structureMemeWeights>
    <xenotypeSet>
      <xenotypeChances>
        <MRWD_AwakenedWorkerDroneBase>999</MRWD_AwakenedWorkerDroneBase>
      </xenotypeChances>
    </xenotypeSet>
    <backstoryFilters>
      <li>
        <categories>
          <li>WorkerDroneBorn</li>
          <li>WorkerDrone</li>
          <li>Offworld</li>
          <li>Outlander</li>
        </categories>
      </li>
    </backstoryFilters>
    <caravanTraderKinds>
      <li>Caravan_WorkerDrone_BulkGoods</li>
      <li>Caravan_WorkerDrone_Exotic</li>
    </caravanTraderKinds>
    <visitorTraderKinds>
      <li>Visitor_WorkerDrone_Standard</li>
    </visitorTraderKinds>
    <baseTraderKinds>
      <li>Base_WorkerDrone_Standard</li>
    </baseTraderKinds>
    <allowedArrivalTemperatureRange>-40~45</allowedArrivalTemperatureRange>
    <raidLootMaker>WorkerDroneRaidLootMaker</raidLootMaker>
    <maxPawnCostPerTotalPointsCurve>
        <points>
            <li>(0, 240)</li>
            <li>(70, 320)</li>
            <li>(300, 420)</li>
            <li>(700, 600)</li>
            <li>(1300, 900)</li>
            <li>(100000, 5000)</li>
        </points>
    </maxPawnCostPerTotalPointsCurve>
    <pawnGroupMakers>
      <li>
        <!-- Normal fights, standard mix -->
        <kindDef>Combat</kindDef>
        <options>
          <MRWD_WorkerDrone>5</MRWD_WorkerDrone>
          <WDF_Grenadier>1.5</WDF_Grenadier>
          <WDF_Slasher>7</WDF_Slasher>
          <WDF_Gunner>20</WDF_Gunner>
          <WDF_Elite>10</WDF_Elite>
          <MRWD_WorkerDrone_town_Councilman>10</MRWD_WorkerDrone_town_Councilman>
        </options>
      </li>
      <li>
        <kindDef>Peaceful</kindDef>
        <options>
          <MRWD_WorkerDrone>20</MRWD_WorkerDrone>
          <WDF_Gunner>10</WDF_Gunner>
          <MRWD_WorkerDrone_town_Councilman>10</MRWD_WorkerDrone_town_Councilman>
        </options>
      </li>
      <li>
        <kindDef>Trader</kindDef>
        <traders>
          <MRWD_WorkerDrone_Trader>1</MRWD_WorkerDrone_Trader>
        </traders>
        <carriers>
          <Muffalo>6</Muffalo>
          <Dromedary>5</Dromedary>
          <Alpaca>2</Alpaca>
          <Elephant>1</Elephant>
        </carriers>
        <guards>
          <MRWD_WorkerDrone>3</MRWD_WorkerDrone>
          <WDF_Gunner>20</WDF_Gunner>
          <WDF_Grenadier>1.5</WDF_Grenadier>
          <WDF_Slasher>7</WDF_Slasher>
          <WDF_Elite>10</WDF_Elite>
        </guards>
      </li>
      <li>
        <kindDef>Settlement</kindDef>
        <options>
          <MRWD_WorkerDrone>10</MRWD_WorkerDrone>
          <WDF_Grenadier>1.5</WDF_Grenadier>
          <WDF_Slasher>7</WDF_Slasher>
          <WDF_Gunner>20</WDF_Gunner>
          <WDF_Elite>10</WDF_Elite>
          <MRWD_WorkerDrone_town_Councilman>10</MRWD_WorkerDrone_town_Councilman>
        </options>
      </li>
      <li MayRequire="Ludeon.RimWorld.Ideology">
        <kindDef>Miners</kindDef>
        <commonality>1</commonality>
        <options>
          <Miner>1</Miner>
        </options>
      </li>
      <li MayRequire="Ludeon.RimWorld.Ideology">
        <kindDef>Hunters</kindDef>
        <commonality>1</commonality>
        <options>
          <Hunter>1</Hunter>
        </options>
      </li>
      <li MayRequire="Ludeon.RimWorld.Ideology">
        <kindDef>Loggers</kindDef>
        <commonality>1</commonality>
        <options>
          <Logger>1</Logger>
        </options>
      </li>
      <li MayRequire="Ludeon.RimWorld.Ideology">
        <kindDef>Farmers</kindDef>
        <commonality>1</commonality>
        <options>
          <Farmer>1</Farmer>
        </options>
      </li>
    </pawnGroupMakers>
    <settlementTexturePath>World/WorldObjects/DefaultSettlement</settlementTexturePath>
    <modExtensions>
      <li Class="VEF.Factions.FactionDefExtension">
        <requiredHillLevels>
          <li>Mountainous</li>
          <li>LargeHills</li>
        </requiredHillLevels>
      </li>
    </modExtensions>
  </FactionDef>

  <ThingSetMakerDef>
    <defName>WorkerDroneRaidLootMaker</defName>
    <root Class="ThingSetMaker_MarketValue">
      <fixedParams>
        <filter>
          <thingDefs>
            <li>Silver</li>
            <li>ComponentIndustrial</li>
            <li>Neutroamine</li>
          </thingDefs>
        </filter>
      </fixedParams>
    </root>
  </ThingSetMakerDef>
</Defs>